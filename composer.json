{
    "name": "graham-campbell/analyzer",
    "description": "Checks if referenced classes really exist.",
    "keywords": ["testing", "classes", "analysis", "analyzer", "Graham Campbell", "GrahamCampbell"],
    "license": "MIT",
    "authors": [
        {
            "name": "Graham Campbell",
            "email": "hello@gjcampbell.co.uk",
            "homepage": "https://github.com/GrahamCampbell"
        }
    ],
    "require": {
        "php": "^8.1",
        "phpdocumentor/reflection-docblock": "^5.6.7 || ^6.0.3",
        "phpdocumentor/type-resolver": "^1.12.0 || ^2.0.0",
        "nikic/php-parser": "^4.19.5 || ^5.7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5.63 || ^11.5.55 || ^12.5.14 || ^13.0.5"
    },
    "suggest": {
        "phpunit/phpunit": "Required to use the analysis trait."
    },
    "autoload": {
        "psr-4": {
            "GrahamCampbell\\Analyzer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GrahamCampbell\\Tests\\Analyzer\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist"
    }
}
